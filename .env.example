# Clés publiques (sûres côté client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Clé secrète — SERVEUR UNIQUEMENT, ne jamais exposer côté client
# Utilisée uniquement dans des routes API / server actions qui en ont
# strictement besoin (ex: opérations SUPER_ADMIN cross-organisation)
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# URL publique du site (utilisée pour générer les QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
